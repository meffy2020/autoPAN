DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autopan

# Local operation storage.
# Keep `memory` for demos. Use `sqlite` for Windows local operation.
AUTOPAN_STORAGE_MODE=memory
# AUTOPAN_SQLITE_PATH=.autopan/autopan.sqlite

# Google Sheets kiosk append.
# Share the spreadsheet with GOOGLE_SHEETS_CLIENT_EMAIL as an editor.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Existing user lookup is read-only in code and only reads this range.
# Required headers in the first row: 이름, 보호자연락처.
# Optional headers: 학교명, 생년월일, 성별, 출생연도.
GOOGLE_SHEETS_MEMBER_RANGE="'사용자DB'!A:Z"
# Optional tab overrides. Defaults: 컴퓨터, 닌텐도, 플스, 무료콘텐츠.
# GOOGLE_SHEETS_PC_TAB_NAME=컴퓨터
# GOOGLE_SHEETS_NINTENDO_TAB_NAME=닌텐도
# GOOGLE_SHEETS_PLAYSTATION_TAB_NAME=플스
# GOOGLE_SHEETS_FREE_TAB_NAME=무료콘텐츠
